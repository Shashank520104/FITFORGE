FROM node:22-bookworm-slim AS build
WORKDIR /app

# Copy root and service manifests
COPY package*.json ./
COPY services/api-gateway/package*.json ./services/api-gateway/
COPY services/auth-service/package*.json ./services/auth-service/
COPY services/workout-service/package*.json ./services/workout-service/
COPY services/nutrition-service/package*.json ./services/nutrition-service/
COPY services/progress-service/package*.json ./services/progress-service/
COPY services/profile-service/package*.json ./services/profile-service/
COPY services/personalization-service/package*.json ./services/personalization-service/

# Install root & service dependencies
RUN npm ci
RUN for dir in services/*; do if [ -d "$dir" ]; then (cd "$dir" && npm ci); fi; done

# Copy service source code and configs
COPY services/ ./services/

# Build TypeScript for each service and prune dev dependencies
RUN for dir in services/*; do if [ -d "$dir" ]; then (cd "$dir" && npm run build && npm prune --omit=dev); fi; done

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app

# Install system utilities needed for personalization text extraction
RUN apt-get update \
  && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-eng \
  && rm -rf /var/lib/apt/lists/*

# Copy built services and startup script
COPY --from=build /app/services/ ./services/
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY scripts/start-render.sh ./scripts/start-render.sh
RUN chmod +x ./scripts/start-render.sh

EXPOSE 3000
CMD ["./scripts/start-render.sh"]
